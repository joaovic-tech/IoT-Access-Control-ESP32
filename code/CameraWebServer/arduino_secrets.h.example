#pragma once
// ==========================================================================
// Modelo de configuracao de segredos do ESP32-CAM.
//
// COMO USAR:
//   1. Copie este arquivo para "arduino_secrets.h" (mesma pasta).
//   2. Preencha os valores reais da sua rede e do servidor de reconhecimento.
//   3. "arduino_secrets.h" e ignorado pelo git (ver .gitignore) e NUNCA
//      deve ser versionado.
//
// Se "arduino_secrets.h" nao existir, o firmware compila usando este .example
// como fallback (com um #warning), mas nao conecta na rede real.
// ==========================================================================

// --- Wi-Fi (modo estacao / STA) ---
#define WIFI_SSID  "YOUR_WIFI_SSID"
#define WIFI_PASS  "YOUR_WIFI_PASSWORD"

// --- Servidor Python de reconhecimento facial (FastAPI) na LAN ---
// Sem barra final. Ex.: "http://192.168.15.10:8000"
#define FACE_SERVER_URL  "http://192.168.15.10:8000"

// --- Token simples opcional para proteger /api/relay, /api/unlock, /api/flash ---
// Deixe comentado para desabilitar a checagem. Quando definido, as rotas de
// atuadores exigem ?key=<valor> na query string.
// #define ACCESS_TOKEN  "troque-este-token"
