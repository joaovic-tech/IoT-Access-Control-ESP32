# Copie para ".env" e ajuste. O arquivo .env e ignorado pelo git.

# --- Servidor HTTP ---
HOST=0.0.0.0
PORT=8000

# --- Reconhecimento facial ---
# Menor = mais rigoroso. 0.6 e o padrao da lib face_recognition.
TOLERANCE=0.6
# Amostras minimas para a pessoa ficar com status "ativo".
MIN_SAMPLES_ACTIVE=3
# Largura maxima analisada pelo detector. Uma foto de celular (2544 px) leva
# ~7,5 s; a mesma em 1024 px leva ~1,6 s e acha o mesmo rosto. 0 desliga.
MAX_ANALYSIS_WIDTH=1024

# Giro aplicado ao quadro ANTES do reconhecimento: 0, 90, 180 ou 270 (horario).
# O detector do dlib NAO encontra rosto de cabeca para baixo, entao uma camera
# montada invertida precisa de ROTATION=180 -- sem isso todo scan da "no_face".
# Vale para o fluxo do PIR (o firmware nao informa orientacao); o app manda o
# valor cadastrado no dispositivo a cada requisicao e esse tem prioridade.
ROTATION=0

# --- Integracao com o ESP32-CAM ---
# Usado por /scan e /enroll/from-esp32 quando o cliente nao informa a URL.
ESP32_DEFAULT_URL=http://192.168.15.72
# Se o firmware definir ACCESS_TOKEN, repita o mesmo valor aqui.
ESP32_ACCESS_TOKEN=
# Quando true, um rosto reconhecido E autorizado dispara {ESP32}/api/unlock.
AUTO_UNLOCK=false

# Timeout (segundos) das chamadas HTTP de saida.
HTTP_TIMEOUT=5

# --- Comodo desta camera ---
# Usado quando o cliente nao informa comodo -- e o caso do firmware no evento
# do PIR. O app manda o comodo cadastrado no dispositivo e tem prioridade.
# O valor e casado por nome com os comodos criados no app (Pessoas -> Comodos).
ROOM=

# --- Assistente do administrador (OPCIONAL, G3) ---
# Modelo local no Ollama que responde perguntas sobre o historico e PROPOE
# mudancas de configuracao -- sempre com confirmacao na tela. Ele NAO decide
# acesso: isso e deterministico em access_control.py.
#   1) instale o Ollama (https://ollama.com) e rode:  ollama pull llama3.1
#   2) preencha OLLAMA_MODEL abaixo
# Vazio = assistente desligado; o resto do sistema funciona igual.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=60

# --- Telegram (OPCIONAL, desligado sem token+chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Vivacidade / anti-spoofing (OPCIONAL, G1) ---
# Barra foto impressa ou tela mostrada a camera. Exige um liveness_model.json
# calibrado com as SUAS amostras:
#   1) monte datasets/liveness/real/ e datasets/liveness/spoof/ (20+ cada)
#   2) .venv\Scripts\python.exe tools/liveness_calibrate.py
#   3) so entao ligue a chave abaixo
# Sem modelo a verificacao nao opina -- falha ABERTA de proposito, para nao
# trancar todo mundo do lado de fora por falta de um arquivo.
LIVENESS_ENABLED=false

# --- Deteccao de presenca (G2) ---
# Quando o reconhecimento nao acha rosto, detectores auxiliares do OpenCV dizem
# se ha alguem no quadro (perfil, pouca luz, so o corpo) -> status
# "person_no_face" em vez de "no_face". Nao baixa nada, ja vem com o OpenCV.
PRESENCE_FALLBACK=true
