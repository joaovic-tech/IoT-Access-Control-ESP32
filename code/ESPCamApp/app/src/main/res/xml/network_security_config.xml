<?xml version="1.0" encoding="utf-8"?>
<!--
  O ESP32-CAM e o servidor Python de faces sao HTTP puro na LAN (nao ha TLS
  num ESP32 servindo MJPEG). O IP de cada dispositivo e configurado pelo
  usuario em tempo de execucao, e o formato <domain> nao aceita faixas CIDR,
  entao o trafego em claro fica liberado no base-config.

  O trafego para a internet publica continua exigindo HTTPS na pratica: o app
  so fala com os enderecos cadastrados pelo usuario na propria rede local.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
